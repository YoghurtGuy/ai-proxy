# 管理后台登录密码（必填，改掉这个值）
ADMIN_PASSWORD=change-me-please

# cookie 签名密钥（可选，不填则用 ADMIN_PASSWORD 派生）
# AUTH_SECRET=用 `openssl rand -hex 32` 生成一个

# 数据目录不用在这里配：直接跑源码时默认 ./data，容器里镜像已经设成 /data。

# 可选：MySQL 连接串，配置后请求日志及输入输出正文将异步批量写入 MySQL（推荐单独建库 ai_proxy）
# MYSQL_URL=mysql://user:pass@127.0.0.1:3306/ai_proxy